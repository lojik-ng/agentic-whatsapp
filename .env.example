# Sample .env — copy to .env and fill in the values for your deployment.
# docker-compose.yml reads these via ${VAR} substitution.
# The same .env file is also loaded into the container via the `env_file`
# directive in docker-compose.yml — so WHATSAPP_API_KEY reaches the Node app.

# ===== docker-compose.yml parameters (used by compose substitution) =====
# The name of the running container. Must be unique per host (no clashes with
# the other service running on the same machine).
CONTAINER_NAME=agentic-whatsapp

# Image name used by `docker compose up -d --build`. Tag is optional
# (defaults to "latest" if unset).
IMAGE_NAME=agentic-whatsapp
IMAGE_TAG=latest

# Port mappings. HOST_PORT is the port exposed on the host; CONTAINER_PORT
# is the port the server actually listens on inside the container. They
# should usually match for a single-port service.
#
# SO line:    HOST_PORT=3056  CONTAINER_PORT=3056
# DOS line:   HOST_PORT=3057  CONTAINER_PORT=3057
HOST_PORT=3056
CONTAINER_PORT=3056

# ===== Runtime secrets (loaded into the container as env vars) =====
# API Key required for all endpoints (except /qr/:apiKey and /status).
WHATSAPP_API_KEY=

# Port for the API server inside the container. MUST match CONTAINER_PORT
# above — the healthcheck reads this env var.
PORT=3056

# Data directory (WhatsApp Web session + SQLite database)
DATA_DIR=./data

# Port for the API
PORT=3056

# API Key required for all endpoints (except /qr/:apiKey and /status).
# Use any string you want.
WHATSAPP_API_KEY=any-string-i-want

# Data directory (session + SQLite database)
DATA_DIR=./data

# Puppeteer / Chrome configuration
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
